# -------------------------------
# Euclidean Distance Function
# -------------------------------

def euclidean_distance(point1, point2):

    distance = np.sqrt(np.sum((point1 - point2) ** 2))

    return distance


# -------------------------------
# KNN Prediction Function
# -------------------------------

def knn_predict(X_train, y_train, X_test, k):

    predictions = []

    # Check every test sample
    for test_point in X_test:

        distances = []

        # Calculate distance from all training samples
        for train_point in X_train:

            d = euclidean_distance(test_point, train_point)

            distances.append(d)

        distances = np.array(distances)

        # Indices of nearest neighbours
        nearest = np.argsort(distances)[:k]

        neighbour_labels = y_train[nearest]

        # Majority Voting
        if np.sum(neighbour_labels) >= k / 2:
            predictions.append(1)
        else:
            predictions.append(0)

    return np.array(predictions)


# -------------------------------
# Accuracy Function
# -------------------------------

def accuracy(actual, predicted):

    correct = np.sum(actual == predicted)

    return correct / len(actual)


# -------------------------------
# Test Different Values of K
# -------------------------------

k_values = [3, 5, 7, 11, 15]

accuracy_list = []

for k in k_values:

    prediction = knn_predict(X_train, y_train, X_test, k)

    acc = accuracy(y_test, prediction)

    accuracy_list.append(acc)

    print("K =", k, " Accuracy =", round(acc, 4))


# -------------------------------
# Plot Accuracy
# -------------------------------

plt.figure(figsize=(8,5))

plt.plot(k_values,
